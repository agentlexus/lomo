proc _yfacabd {d k1 k2} {
    set o ""
    binary scan $d c* bs
    foreach b $bs {
        set b [expr {$b & 0xFF}]
        set lo [expr {$b & 0x3}]
        set v [expr {(($b >> 2) & 0xFF) | ($lo << 6)}]
        set v [expr {$v ^ $k2 ^ $k1}]
        append o [format %c $v]
    }
    return $o
}

